APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#--------------------------------------------------------------------------
# API (website / general)
#--------------------------------------------------------------------------
# Shared secret for public website APIs such as POST /api/estimate.
# Send as X-API-Token or Authorization: Bearer {API_TOKEN}.
# Production: serve API over HTTPS only (TLS at reverse proxy / APP_URL).
API_TOKEN=

# Comma-separated frontend origins allowed to call /api/* from the browser (Next.js, etc.)
# Examples: http://localhost:3000  or  http://localhost:3000,https://dev.tarjuman.ae
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://dev.tarjuman.ae

# Marketing site (Next.js) base URL for CMS full-page preview iframes
FRONTEND_URL=http://localhost:3000

# Admin origins allowed to postMessage the CMS preview iframe (comma-separated)
CMS_PREVIEW_ORIGINS="${APP_URL}"

#--------------------------------------------------------------------------
# JWT (upcoming authenticated customer APIs)
#--------------------------------------------------------------------------
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

#--------------------------------------------------------------------------
# Estimation / OCR (free Tesseract)
#--------------------------------------------------------------------------
ESTIMATION_WORDS_PER_PAGE=250
ESTIMATION_MAX_FILES=10
ESTIMATION_MAX_FILE_KB=10240
ESTIMATION_OCR_ENABLED=true
# Absolute path required on Windows if tesseract is not on PATH, e.g.:
# TESSERACT_BINARY="C:/Program Files/Tesseract-OCR/tesseract.exe"
TESSERACT_BINARY=
TESSERACT_FALLBACK_LANGUAGE=eng
# Always OCR English too (bilingual certificates). Comma-separated Tesseract packs.
TESSERACT_ALWAYS_INCLUDE=eng
TESSERACT_TIMEOUT=60
TESSERACT_PSM=6
TESSERACT_DPI=300
# Drop low-confidence OCR tokens (dotted lines, logos, noise). Range 0–100.
TESSERACT_MIN_CONFIDENCE=60
